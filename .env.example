# Copiar este archivo como .env y completar con los valores reales.
# El .env NO se versiona: esta en el .gitignore.

# Credenciales del remote de DVC (DagsHub)
DAGSHUB_USER=
DAGSHUB_TOKEN=

# MLflow remoto en DagsHub. Si se dejan vacias, MLflow usa la base local
# mlflow.db y la carpeta mlartifacts/.
# MLFLOW_TRACKING_URI=https://dagshub.com/<usuario>/customer-churn-ml.mlflow
# MLFLOW_TRACKING_USERNAME=<usuario de DagsHub>
# MLFLOW_TRACKING_PASSWORD=<token de DagsHub>

# Modelo que carga la API. Por defecto: models:/CustomerChurnModel@production
# MODEL_URI=models:/CustomerChurnModel@production
